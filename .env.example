# Общие параметры приложения и Docker Compose.
# Скопируйте этот файл в .env и заполните значения перед запуском.

# Режим Gin: true включает подробный debug-режим, false — production.
DEBUG=false

# PostgreSQL. Для Docker Compose production DB_HOST/DB_PORT будут заданы
# как postgres:5432. Для запуска backend вне Compose используйте localhost.
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=daily_energy
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
DB_NAME=daily_energy

# Создайте бота через @BotFather и вставьте токен.
# Нужен для polling бота и проверки подписи Telegram initData.
TELEGRAM_BOT_TOKEN=

# Публичный HTTPS URL Mini App. Задайте тот же домен, что и в SERVER_NAME.
# Например: https://app.example.com/
MINI_APP_URL=

# AI API. По умолчанию используется OpenRouter Chat Completions API.
API_PATH=https://openrouter.ai/api/v1/chat/completions
API_KEY=

# Разрешённые CORS origins через запятую. Укажите origin без завершающего /.
# При доступе к frontend и API через один Nginx-домен обычно достаточно
# origin из MINI_APP_URL; для локального Vite можно добавить localhost.
ALLOW_ORIGINS=https://app.example.com,http://localhost:5173,http://localhost:5174

# Production-домен только как hostname: без https:// и без пути.
# Должен разрешаться на сервер с Docker, где открыты TCP-порты 80 и 443.
SERVER_NAME=app.example.com

# Email для регистрации сертификата Let's Encrypt.
CERTBOT_EMAIL=

# Тег локально собираемых production-образов.
TAG=latest

# Базовый URL API для frontend.
# Оставьте пустым в production: frontend будет обращаться к /api на том же
# HTTPS origin через Nginx. Конфигуратор dev/full выставляет localhost:8080.
VITE_API_URL=
